# Common settings
DESKCAM_INTERVAL=300
DESKCAM_TIMEOUT=10

# HTTP / WebDAV-style single image
# DESKCAM_SOURCE=http
# DESKCAM_HTTP_SELECTION=single
# DESKCAM_HTTP_URL=https://example.com/camera/current.jpg

# HTTP / WebDAV latest file in a directory
# DESKCAM_SOURCE=http
# DESKCAM_HTTP_SELECTION=latest
# DESKCAM_HTTP_DIRECTORY_URL=https://example.com/camera/

# S3 credentials
# For systemd deployments, prefer placing these in /etc/deskcam.env with chmod 600.
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# AWS_SESSION_TOKEN=OPTIONAL_SESSION_TOKEN

# S3 fixed key
# DESKCAM_SOURCE=s3
# DESKCAM_S3_BUCKET=your-bucket
# DESKCAM_S3_REGION=us-east-1
# DESKCAM_S3_ENDPOINT_URL=https://s3.amazonaws.com
# DESKCAM_S3_SELECTION=single
# DESKCAM_S3_KEY=cameras/lobby/current.jpg

# S3 latest object under a prefix
# DESKCAM_SOURCE=s3
# DESKCAM_S3_BUCKET=your-bucket
# DESKCAM_S3_REGION=us-east-1
# DESKCAM_S3_ENDPOINT_URL=https://s3.amazonaws.com
# DESKCAM_S3_SELECTION=latest
# DESKCAM_S3_PREFIX=cameras/lobby/

# S3 latest JPG/JPEG object from bucket root
# DESKCAM_SOURCE=s3
# DESKCAM_S3_BUCKET=your-bucket
# DESKCAM_S3_REGION=us-east-1
# DESKCAM_S3_SELECTION=latest
# DESKCAM_S3_PREFIX=
