# ============================================================
# Common settings
# ============================================================
DESKCAM_INTERVAL=300
DESKCAM_TIMEOUT=10

# ============================================================
# HTTP / WebDAV source
# ============================================================

# Single fixed image URL
# DESKCAM_SOURCE=http
# DESKCAM_HTTP_SELECTION=single
# DESKCAM_HTTP_URL=https://example.com/camera/current.jpg

# Latest JPEG in a WebDAV directory
# DESKCAM_SOURCE=http
# DESKCAM_HTTP_SELECTION=latest
# DESKCAM_HTTP_DIRECTORY_URL=https://example.com/camera/

# ============================================================
# S3 / S3-compatible source
# ============================================================
# For systemd deployments, prefer placing credentials in
# /etc/deskcam.env with chmod 600.

# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
# AWS_SESSION_TOKEN=OPTIONAL_SESSION_TOKEN

# Single fixed S3 object
# DESKCAM_SOURCE=s3
# DESKCAM_S3_BUCKET=your-bucket
# DESKCAM_S3_REGION=us-east-1
# DESKCAM_S3_ENDPOINT_URL=https://s3.amazonaws.com
# DESKCAM_S3_SELECTION=single
# DESKCAM_S3_KEY=cameras/lobby/current.jpg

# Latest JPEG under a prefix (leave prefix empty for bucket root)
# DESKCAM_SOURCE=s3
# DESKCAM_S3_BUCKET=your-bucket
# DESKCAM_S3_REGION=us-east-1
# DESKCAM_S3_ENDPOINT_URL=https://s3.amazonaws.com
# DESKCAM_S3_SELECTION=latest
# DESKCAM_S3_PREFIX=cameras/lobby/

# ============================================================
# FTPS source (explicit TLS, port 21)
# ============================================================
# For systemd deployments, prefer placing credentials in
# /etc/deskcam.env with chmod 600.

# Single fixed file (only downloaded when the file has changed)
# DESKCAM_SOURCE=ftps
# DESKCAM_FTPS_HOST=ftp.example.com
# DESKCAM_FTPS_PORT=21
# DESKCAM_FTPS_USERNAME=your-username
# DESKCAM_FTPS_PASSWORD=your-password
# DESKCAM_FTPS_SELECTION=single
# DESKCAM_FTPS_PATH=/cameras/lobby/current.jpg

# Latest JPEG in a directory
# DESKCAM_SOURCE=ftps
# DESKCAM_FTPS_HOST=ftp.example.com
# DESKCAM_FTPS_PORT=21
# DESKCAM_FTPS_USERNAME=your-username
# DESKCAM_FTPS_PASSWORD=your-password
# DESKCAM_FTPS_SELECTION=latest
# DESKCAM_FTPS_DIRECTORY=/cameras/lobby/
